# Supabase project URL (Project Settings > API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Project Settings > API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same Supabase project URL, read server-side by API routes and scripts
# (src/pages/api/*, src/scripts/*). Usually identical to
# NEXT_PUBLIC_SUPABASE_URL above — kept as a separate var so server code
# never accidentally depends on a NEXT_PUBLIC_* var being present.
SUPABASE_URL=

# Supabase service role key. SERVER-SIDE ONLY. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret generate-newsletter.ts checks as X-Service-Token so
# weekly-newsletter.yml can trigger it without a logged-in user's session.
# Generate a long random value and keep it out of client-side code entirely.
# Not named GITHUB_ACTIONS_TOKEN (an earlier name) — GitHub rejects any repo
# secret starting with GITHUB_ as reserved for its own auto-generated ones.
NEWSLETTER_SERVICE_TOKEN=

# Azure OpenAI resource endpoint, used for AI summarisation of scan results
# and the weekly newsletter narrative (src/lib/scanners/, src/lib/newsletter.ts).
# Falls back to a deterministic templated summary/post when unset.
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI API key. SERVER-SIDE ONLY.
AZURE_OPENAI_KEY=

# Azure OpenAI deployment name (the name you gave the model deployment in
# the Azure OpenAI Studio, not the underlying model name).
AZURE_OPENAI_DEPLOYMENT=

# Stripe secret key (test mode: sk_test_...). SERVER-SIDE ONLY.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret, from the Stripe CLI or Dashboard webhook config.
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (Dashboard > Product > Pricing > API ID, "price_...") for
# each subscription tier — required for /api/stripe/create-checkout-session.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Public site URL — used to build Stripe Checkout success/cancel redirect
# URLs, Slack alert links (src/lib/slack.ts), and by weekly-newsletter.yml
# to call this app's own /api/generate-newsletter from outside. No
# NEXT_PUBLIC_AZURE_FUNCTIONS_URL needed anymore: run-scan/verify-ownership/
# generate-report/generate-fix-pr/generate-newsletter are all Next.js API
# routes on this same app now (see src/pages/api/run-scan.ts's header
# comment). Safe to expose.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID ("G-XXXXXXX"). Safe to expose — GA
# script only loads client-side after the user accepts the cookie consent
# banner (src/components/CookieConsent.tsx, src/components/GoogleAnalytics.tsx).
# Leave unset to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Azure Storage connection string. SERVER-SIDE ONLY. When set, generate-report
# uploads PDFs to Blob Storage and returns a SAS URL instead of the raw PDF
# bytes — see src/functions/generate-report/index.ts.
AZURE_STORAGE_CONNECTION_STRING=

# Upstash Redis REST credentials (https://upstash.com — free tier is fine),
# used for real shared-state rate limiting in run-scan (src/lib/rateLimit.ts).
# Falls back to an in-memory limiter (dev only, not safe across Function
# instances) if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Base URL of a reachable OWASP ZAP daemon's API (e.g. a `zaproxy/zap-stable`
# container with the API enabled), used by checkZap() in src/lib/scanners/.
# Only kicks off a spider scan — see the TODO there about polling for results.
# Leave unset to skip this check (returns a "not_configured" stub result).
ZAP_API_URL=

# GitHub personal access token (or GitHub App installation token — see TODO
# in src/pages/api/generate-fix-pr.ts), used for two things against two
# different repos:
#   - contents:write + pull-requests:write on a CUSTOMER's repo, to open
#     remediation PRs (generate-fix-pr.ts) and read secretScan.ts's manifest.
#   - actions:write on THIS repo, to dispatch on-demand-scan.yml the moment a
#     customer clicks "Run scan" (src/pages/api/run-scan.ts) instead of
#     waiting for scheduled-scans.yml's daily cron. Optional — if unset,
#     on-demand scans still complete, just via that daily cron instead of
#     within about a minute.
# A fine-grained PAT scoped to this repo plus whichever customer repos have
# added the bot as a collaborator covers both; a classic PAT with `repo` +
# `workflow` scope also works.
GITHUB_PAT=

# Set to "true" to ENABLE the dev-only X-Scan-Token ownership fallback in
# run-scan, letting a scan run without real DNS/file verification
# (src/lib/ownership.ts, src/pages/api/verify-ownership.ts). Defaults to
# unset/"false" — domain verification is required on every deployment
# unless you explicitly opt into the shortcut for local dev.
ALLOW_DEV_TOKEN_VERIFICATION=false

# Resend API key (https://resend.com — free tier: 100 emails/day). When set,
# the /api/contact route sends an email notification to CONTACT_EMAIL on every
# new enquiry. Leave unset to skip email — submissions are always stored in the
# contact_enquiries Supabase table regardless.
RESEND_API_KEY=

# Destination address for contact-form notification emails. Defaults to
# hello@hebridescyber.com if unset. Only used when RESEND_API_KEY is set.
CONTACT_EMAIL=hello@hebridescyber.com

# Shared secret send-monthly-digest.ts checks as X-Service-Token so
# monthly-digest.yml can trigger it without a logged-in user's session —
# same pattern as NEWSLETTER_SERVICE_TOKEN above. Generate a separate long
# random value (don't reuse NEWSLETTER_SERVICE_TOKEN) and keep it out of
# client-side code entirely. Not named GITHUB_*  — GitHub rejects any repo
# secret starting with GITHUB_ as reserved for its own auto-generated ones.
DIGEST_SERVICE_TOKEN=

# Optional — only used by `npm run scan:local` to persist a local scan run
# to Supabase for test-data seeding. A real auth.users id from your project.
SCAN_OWNER_ID=

# Optional — password used for ALL accounts created by `npm run seed:users`
# (admin@hebridescyber.com + basic/pro/agency/no-plan demo customers).
# Defaults to "HebridesDev123!" if unset. Local/demo use only — these are
# real password-authenticated accounts once created, so don't run this
# script against a production Supabase project with the default password.
SEED_USER_PASSWORD=

# Google Safe Browsing API key, used by checkSafeBrowsing() in
# src/lib/scanners/safeBrowsing.ts to check the target URL against Google's
# live malware/phishing/unwanted-software threat lists. Get one from the
# Google Cloud Console: create (or pick) a project, enable the "Safe
# Browsing API" under APIs & Services, then create an API key under
# Credentials and restrict it to that API only. Leave unset to skip this
# check (returns a "not_configured" stub result).
GOOGLE_SAFE_BROWSING_API_KEY=

# HaveIBeenPwned API key, used by checkHibp() in src/lib/scanners/hibp.ts to
# check whether email addresses on the target domain have appeared in known
# data breaches. Get one from https://haveibeenpwned.com/API/Key — paid only,
# no free tier for domain search (Core 1 starts around $4.39/mo and scales up
# with the domain's breached-address count, not flat-rate).
#
# IMPORTANT CAVEAT: a key alone is not enough. HIBP's domain search requires
# the domain to be separately verified *with HIBP itself* (their own
# dashboard: Business -> Domain Search -> Add domain -> DNS TXT / meta tag /
# file / admin-email verification) before it will return any data for that
# domain — this is unrelated to and not satisfied by this app's own
# src/lib/ownership.ts verification. Until a domain completes HIBP's own
# verification, checkHibp() returns status "not_verified" (not an error, not
# a false "no breaches") for it, even with a valid key configured here.
# Leave this unset to skip the check entirely (returns "not_configured").
HIBP_API_KEY=
