# Supabase project URL (Project Settings > API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Project Settings > API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same Supabase project URL, read server-side by API routes and scripts
# (src/pages/api/*, src/scripts/*). Usually identical to
# NEXT_PUBLIC_SUPABASE_URL above — kept as a separate var so server code
# never accidentally depends on a NEXT_PUBLIC_* var being present.
SUPABASE_URL=

# Supabase service role key. SERVER-SIDE ONLY. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Encryption key for stored cloud-provider credentials (AES-256-GCM, see
# src/lib/credentialEncryption.ts). SERVER-SIDE ONLY. 32 bytes as base64 or hex.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required to SAVE cloud credentials (/api/account/cloud-credentials) — writes
# return 503 while unset (fail-closed; never stores plaintext). Rotating it makes
# previously-saved credentials unreadable until re-entered.
CREDENTIALS_ENC_KEY=

# Azure OpenAI resource endpoint, used for AI summarisation of scan results
# and the weekly newsletter narrative (src/lib/scanners/, src/lib/newsletter.ts).
# Falls back to a deterministic templated summary/post when unset.
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI API key. SERVER-SIDE ONLY.
AZURE_OPENAI_KEY=

# Azure OpenAI deployment name (the name you gave the model deployment in
# the Azure OpenAI Studio, not the underlying model name).
AZURE_OPENAI_DEPLOYMENT=

# Stripe secret key (test mode: sk_test_...). SERVER-SIDE ONLY.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret, from the Stripe CLI or Dashboard webhook config.
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (Dashboard > Product > Pricing > API ID, "price_...") for
# each subscription tier — required for /api/stripe/create-checkout-session.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
# Tier A (top tier): unlocks the opt-in offensive scan mode. Leave blank until
# the product/ToS decision to sell it is made — checkout answers 503 until set.
STRIPE_PRICE_TIER_A=

# Public site URL — used to build Stripe Checkout success/cancel redirect
# URLs, Slack/Teams alert links (src/lib/slack.ts, src/lib/msTeams.ts), and
# dashboard/report links baked into ticket-integration and critical-alert
# emails. No NEXT_PUBLIC_AZURE_FUNCTIONS_URL needed: run-scan/verify-
# ownership/generate-report/generate-fix-pr are all Next.js API routes on
# this same app (see src/pages/api/run-scan.ts's header comment); the daily
# blog and weekly newsletter are standalone scripts
# (src/scripts/generate-daily-blog.ts, generate-weekly-newsletter.ts) run
# directly by their own GitHub Actions workflows against Supabase — not API
# routes, and not reachable via this URL at all. Safe to expose.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID ("G-XXXXXXX"). Safe to expose — GA
# script only loads client-side after the user accepts the cookie consent
# banner (src/components/CookieConsent.tsx, src/components/GoogleAnalytics.tsx).
# Leave unset to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Azure Storage connection string. SERVER-SIDE ONLY. When set,
# generate-report (src/pages/api/generate-report.ts) uploads PDFs to Blob
# Storage and returns a SAS URL instead of the raw PDF bytes. Also
# REQUIRED (not optional) for image/logo upload — admin blog images
# (src/pages/api/admin/blog/upload-image.ts) and Agency white-label
# branding logos (src/pages/api/account/branding-logo.ts) both 503 without
# it.
AZURE_STORAGE_CONNECTION_STRING=

# Azure Blob Storage container name used by the two upload routes above.
# Defaults to "public" if unset.
AZURE_STORAGE_CONTAINER=

# Upstash Redis REST credentials (https://upstash.com — free tier is fine),
# used for real shared-state rate limiting in run-scan (src/lib/rateLimit.ts).
# Falls back to an in-memory limiter (dev only, not safe across Function
# instances) if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How many X-Forwarded-For entries our own proxies append, counted from the
# right — getClientIp() (src/lib/rateLimit.ts) takes the entry just inside
# them, so a client can't forge its IP for rate limits or API-key allowlists.
# Leave unset for Azure Static Web Apps (2, measured in production). Set 1 on
# the Azure Container Apps path, whose ingress appends a single entry.
TRUSTED_PROXY_HOPS=

# Base URL of a reachable OWASP ZAP daemon's API (e.g. a `zaproxy/zap-stable`
# container with the API enabled), used by checkZap() in src/lib/scanners/
# and the extended active-scan integration in src/worker/tools/zap.ts.
# Only kicks off a spider scan — see the TODO there about polling for results.
# Leave unset to skip this check (returns a "not_configured" stub result).
ZAP_API_URL=

# API key for the ZAP daemon above. SERVER-SIDE ONLY. KNOWN GAP: if this is
# left unset while ZAP_API_URL IS set, src/worker/tools/zap.ts currently
# falls back to the literal string "changeme" rather than failing — a
# trivially guessable credential for a security tool's own API (tracked as
# docs/ENHANCEMENTS.md E-14). Always set this explicitly alongside
# ZAP_API_URL; don't rely on the fallback.
ZAP_API_KEY=

# NAMING NOTE for all three GITHUB_* vars below: this is the name to use
# for the .env.local var, the Azure Static Web App application setting, AND
# the process.env name read in code (src/lib/githubApp.ts and every scanner
# module) — but NOT the GitHub Actions secret name. GitHub hard-rejects
# (HTTP 422) any Actions secret starting with "GITHUB_", reserved for its
# own auto-generated ones. scheduled-scans.yml's `work` job stores these
# under GH_PAT / GH_APP_ID / GH_APP_PRIVATE_KEY instead and maps them back
# to the GITHUB_* env var names in its own `env:` block — set the GitHub
# Actions secrets under those GH_* names, confirmed the hard way when
# `gh secret set GITHUB_PAT` itself 422'd.
#
# GitHub personal access token, used for two DIFFERENT concerns — don't
# conflate them when rotating or scoping this token:
#   - actions:write on THIS repo, to dispatch on-demand-scan.yml the moment a
#     customer clicks "Run scan" (src/lib/onDemandScanTrigger.ts). Optional —
#     if unset, on-demand scans still complete, just via the daily
#     scheduled-scans.yml cron instead of within about a minute. Always uses
#     this PAT directly; the GitHub App below has no bearing on this path,
#     since it's THIS repo's own Actions, not a customer's.
#   - contents:write + pull-requests:write on a CUSTOMER's repo (remediation
#     PRs, dependency version bumps, secret scanning, dependency manifest
#     scanning, Dockerfile base-image scanning). This is the fallback path —
#     see GITHUB_APP_ID below for the preferred one. A fine-grained PAT
#     scoped to this repo plus whichever customer repos have added the bot
#     as a collaborator covers both bullets; a classic PAT with `repo` +
#     `workflow` scope also works.
GITHUB_PAT=

# GitHub App credentials (preferred over GITHUB_PAT for customer-repo
# access — see src/lib/githubApp.ts's header comment for the full setup
# steps and why: a per-installation token is scoped to only the repos that
# installation covers and expires in an hour, instead of one long-lived
# token with access to every customer repo the bot's ever been added to).
# Optional — customer repos that haven't installed the App keep working via
# GITHUB_PAT above with zero change. GITHUB_APP_PRIVATE_KEY is the full
# contents of the .pem GitHub generates, with real newlines (or "\n"
# escapes — either works, see signAppJwt()).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Set to "true" to ENABLE the dev-only X-Scan-Token ownership fallback in
# run-scan, letting a scan run without real DNS/file verification
# (src/lib/ownership.ts, src/pages/api/verify-ownership.ts). Defaults to
# unset/"false" — domain verification is required on every deployment
# unless you explicitly opt into the shortcut for local dev.
ALLOW_DEV_TOKEN_VERIFICATION=false

# Resend API key (https://resend.com — free tier: 100 emails/day), used by
# src/lib/email.ts's sendEmail() — the contact-form notification
# (/api/contact), critical-finding scan alerts (src/lib/scanAlerts.ts, any
# active plan including Basic), and the monthly digest
# (send-monthly-digest.ts). Leave unset to skip email on all of these —
# submissions/alerts are still stored, just not emailed.
RESEND_API_KEY=

# Optional NVD API key (https://nvd.nist.gov/developers/request-an-api-key).
# Used by the emerging-threat alerts job (src/scripts/check-emerging-threats.ts)
# to raise NVD's rate limit from 5 to 50 requests per 30s; without it the job
# just waits longer between lookups.
NVD_API_KEY=

# Destination address for contact-form notification emails. Defaults to
# hello@hebridescyber.com if unset. Only used when RESEND_API_KEY is set.
CONTACT_EMAIL=hello@hebridescyber.com

# SendGrid API key. SERVER-SIDE ONLY. Used ONLY by the Stripe webhook's
# subscription-welcome email (src/pages/api/stripe/webhook.ts) — a separate
# provider from Resend above, which every other email in the app uses. This
# split looks like it should be one provider and isn't currently
# consolidated; treat it as a known inconsistency, not an intentional
# design choice, if you're touching either path. Leave unset to skip the
# welcome email — the subscription itself still activates normally.
SENDGRID_API_KEY=

# "From" address for the SendGrid welcome email above. Defaults to
# hello@hebridescyber.co.uk if unset. Only used when SENDGRID_API_KEY is set.
SENDGRID_FROM_EMAIL=

# send-monthly-digest.ts (like the daily blog and weekly newsletter) runs as
# a bare script against Supabase with no HTTP hop — no service token needed.
# See CLAUDE.md's "Content generation" section and docs/ENHANCEMENTS.md E-11.

# Optional — only used by `npm run scan:local` to persist a local scan run
# to Supabase for test-data seeding. A real auth.users id from your project.
SCAN_OWNER_ID=

# Optional — password used for ALL accounts created by `npm run seed:users`
# (admin@hebridescyber.com + basic/pro/agency/no-plan demo customers).
# Defaults to "HebridesDev123!" if unset. Local/demo use only — these are
# real password-authenticated accounts once created, so don't run this
# script against a production Supabase project with the default password.
SEED_USER_PASSWORD=

# Google Safe Browsing API key, used by checkSafeBrowsing() in
# src/lib/scanners/safeBrowsing.ts to check the target URL against Google's
# live malware/phishing/unwanted-software threat lists. Get one from the
# Google Cloud Console: create (or pick) a project, enable the "Safe
# Browsing API" under APIs & Services, then create an API key under
# Credentials and restrict it to that API only. Leave unset to skip this
# check (returns a "not_configured" stub result).
GOOGLE_SAFE_BROWSING_API_KEY=

# HaveIBeenPwned API key, used by checkHibp() in src/lib/scanners/hibp.ts to
# check whether email addresses on the target domain have appeared in known
# data breaches. Get one from https://haveibeenpwned.com/API/Key — paid only,
# no free tier for domain search (Core 1 starts around $4.39/mo and scales up
# with the domain's breached-address count, not flat-rate).
#
# IMPORTANT CAVEAT: a key alone is not enough. HIBP's domain search requires
# the domain to be separately verified *with HIBP itself* (their own
# dashboard: Business -> Domain Search -> Add domain -> DNS TXT / meta tag /
# file / admin-email verification) before it will return any data for that
# domain — this is unrelated to and not satisfied by this app's own
# src/lib/ownership.ts verification. Until a domain completes HIBP's own
# verification, checkHibp() returns status "not_verified" (not an error, not
# a false "no breaches") for it, even with a valid key configured here.
# Leave this unset to skip the check entirely (returns "not_configured").
HIBP_API_KEY=

# WPScan Vulnerability Database API token, used by checkWpVulnDb() in
# src/lib/scanners/wpvdb.ts to match WordPress plugins detected by
# webapp.ts's checkWordPress() against real, disclosed CVEs — closes a gap
# OSV.dev can't (it has no WordPress ecosystem coverage). Free tier
# available at https://wpscan.com/api (25 requests/day at the time this was
# written). Leave unset to skip this check (returns a "not_configured" stub
# result) — the plain wp-plugin-detected finding still appears either way.
WPSCAN_API_TOKEN=

# Slack incoming webhook URL for ADMIN/OPERATIONAL alerting (src/lib/slack.ts)
# — completely separate from the per-customer Slack webhook customers set
# in their own dashboard (subscriptions.slack_webhook_url), which needs no
# env var at all. Leave unset if you don't want operational alerts sent
# anywhere.
SLACK_WEBHOOK_URL=

# Path to a testssl.sh binary outside $PATH, used by the extended-suite deep
# TLS scan (src/lib/scanners/deepTls.ts). Defaults to "testssl.sh" (i.e.
# expects it on PATH) if unset — scheduled-scans.yml installs it fresh per
# run, so this normally doesn't need setting outside a custom environment.
TESTSSL_PATH=

# Identifies this worker instance in scan_jobs.claimed_by
# (src/scripts/run-queued-scan-jobs.ts) — purely diagnostic, for telling
# concurrent worker shards apart in logs/DB rows. Defaults to
# "local-<pid>" if unset; scheduled-scans.yml's matrix sets this per shard.
WORKER_ID=

# Sentry DSN for error tracking (E-03, docs/ENHANCEMENTS.md) — src/instrumentation.ts,
# src/instrumentation-client.ts, src/sentry.server.config.ts,
# src/sentry.edge.config.ts. Sentry DSNs are not secret (they only permit
# *sending* error events, not reading anything back) — safe to use the same
# value for both. Leave both unset to skip error tracking entirely; the SDK
# initializes into a real no-op, not a broken one. Create a free account at
# sentry.io (Developer plan, 5k errors/month) to get a DSN.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional, only for automatic source-map upload at build time (readable
# stack traces in Sentry instead of minified ones) — from Sentry's own
# org/project settings and an auth token you create there. Leave all three
# unset to skip source-map upload; the build succeeds either way.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
